rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isPinAdmin() {
      return request.auth != null
        && request.auth.token.email == 'order-baju-defile-admin@visualizermaroa.app';
    }

    match /apps/order-baju-defile {
      allow read: if true;
      allow create, update, delete: if isPinAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
